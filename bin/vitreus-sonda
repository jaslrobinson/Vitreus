#!/usr/bin/env python3
"""vitreus-sonda QUERY [UNDER] [KINDS]: asks Sonda (github.com/k4ditano/sonda) what is in your files, for Files' "Meaning" search.

One question to the Sonda daemon's socket ($SONDA_SOCKET, else $XDG_RUNTIME_DIR/sonda.sock), one JSON line back, printed as it came: {"ok": true, "hits": [{"path",
"score", "kind", "segment", "loc", …}], "ms": …}, or {"ok": false, "error": "…"}. UNDER keeps the finds inside that folder ("" for anywhere); KINDS is a comma list of
Sonda's kinds (image, pdf, doc, audio, video; "" for any). It never starts the daemon (sonda.service does): when nothing answers it says so and exits 1.
"""
import json
import os
import socket
import sys


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    q = sys.argv[1]
    under = sys.argv[2] if len(sys.argv) > 2 else ""
    kinds = [k for k in (sys.argv[3] if len(sys.argv) > 3 else "").split(",") if k]
    req = {"op": "search", "q": q, "limit": 80}
    if under:
        req["under"] = under
    if kinds:
        req["kinds"] = kinds
    path = os.environ.get("SONDA_SOCKET") or os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "sonda.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(60)
            s.connect(path)
            s.sendall((json.dumps(req) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                part = s.recv(65536)
                if not part:
                    break
                buf += part
    except OSError as e:
        print(json.dumps({"ok": False, "error": f"Sonda is not running ({e.strerror or e})"}))
        return 1
    sys.stdout.write(buf.decode(errors="replace").strip() + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
